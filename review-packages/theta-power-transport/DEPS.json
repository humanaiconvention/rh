  "actual_definition": "def powerMomentGap (k : ℕ) : ℝ :=\n  (∫ u in Ioi (0 : ℝ), u^k * thetaDensity u) -\n    ∫ u in Ioi (0 : ℝ), u^k * macdonaldDensity u",
  "actual_declarations": [
    {
      "name": "ThetaMacdonald.PowerCoordinate.powerMomentGap_pos",
      "signature": "theorem powerMomentGap_pos (k : ℕ) (hk : 0 < k) : 0 < powerMomentGap k"
    },
    {
      "name": "ThetaMacdonald.PowerCoordinate.powerMomentGap_eq_signed",
      "signature": "theorem powerMomentGap_eq_signed (k : ℕ) :\n    powerMomentGap k = ∫ u in Ioi (0 : ℝ), u^k * densityDifference u"
    },
    {
      "name": "ThetaMacdonald.PowerCoordinate.actual_power_coordinate_measurable",
      "signature": "theorem actual_power_coordinate_measurable (k : ℕ) :\n    AEMeasurable (fun u : ℝ => u^k) (volume.restrict (Ioi (0 : ℝ)))"
    },
    {
      "name": "ThetaMacdonald.PowerCoordinate.actual_power_crossing_ae",
      "signature": "theorem actual_power_crossing_ae (k : ℕ) :\n    ∃ a : ℝ, ∀ᵐ u ∂(volume.restrict (Ioi (0 : ℝ))),\n      0 ≤ (u^k - a) * densityDifference u"
    },
    {
      "name": "ThetaMacdonald.PowerCoordinate.actual_power_weighted_integrable",
      "signature": "theorem actual_power_weighted_integrable (k : ℕ) {φ : ℝ → ℝ} {K : ℝ≥0}\n    (hφ : LipschitzWith K φ) :\n    IntegrableOn (fun u => φ (u^k) * thetaDensity u) (Ioi (0 : ℝ)) ∧\n      IntegrableOn (fun u => φ (u^k) * macdonaldDensity u) (Ioi (0 : ℝ))"
    },
    {
      "name": "ThetaMacdonald.PowerCoordinate.actual_power_lipschitz_gap_le",
      "signature": "theorem actual_power_lipschitz_gap_le (k : ℕ) {φ : ℝ → ℝ} {K : ℝ≥0}\n    (hφ : LipschitzWith K φ) :\n    |(∫ u in Ioi (0 : ℝ), φ (u^k) * thetaDensity u) -\n      ∫ u in Ioi (0 : ℝ), φ (u^k) * macdonaldDensity u| ≤\n        (K : ℝ) * powerMomentGap k"
    },
    {
      "name": "ThetaMacdonald.PowerCoordinate.actual_positive_power_budget_iff",
      "signature": "theorem actual_positive_power_budget_iff (k : ℕ) (hk : 0 < k) {B : ℝ} :\n    (∀ φ : ℝ → ℝ, LipschitzWith 1 φ →\n      |(∫ u in Ioi (0 : ℝ), φ (u^k) * thetaDensity u) -\n        ∫ u in Ioi (0 : ℝ), φ (u^k) * macdonaldDensity u| ≤ B) ↔\n      powerMomentGap k ≤ B"
    }
  ],
